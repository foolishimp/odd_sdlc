{
  "kind": "sdlc_tenant_testing_technology_stack_description",
  "testRunner": "sbt test",
  "testRoots": [
    "cdme-core/src/test/scala",
    "cdme-compiler/src/test/scala",
    "cdme-assurance/src/test/scala",
    "cdme-executor/src/test/scala",
    "cdme-adjoint/src/test/scala",
    "cdme-accounting/src/test/scala",
    "cdme-fidelity/src/test/scala",
    "cdme-engine/src/test/scala"
  ],
  "testingBuildConfigTargets": [
    "build.sbt",
    "project/"
  ],
  "proofCommands": [
    "sbt test"
  ],
  "evidenceFormat": "process-exit",
  "cleanupRules": [
    "target/",
    "project/target/"
  ],
  "toolEnvironment": {
    "disabledTools": [
      "python",
      "python3",
      "pip",
      "pip3"
    ],
    "policy": "Scala/SBT test execution uses declared JVM/SBT tooling; Python is disabled for this tenant."
  }
}
