{
  "kind": "sdlc_tenant_technology_stack_description",
  "language": "JavaScript",
  "runtime": {
    "name": "Node.js",
    "moduleSystem": "esm"
  },
  "buildTool": "node",
  "packageManager": "npm",
  "executionEnvironment": {
    "hostCachePolicy": "prohibited",
    "workspaceLocalDirectories": [],
    "environmentVariables": {}
  },
  "sourceFiles": [
    "src/hello.js",
    "src/world.js",
    "src/index.js"
  ],
  "buildConfigTargets": [
    "package.json"
  ],
  "testingTechStack": {
    "testRunner": "node",
    "testCommand": "node --test test/hello.test.js test/world.test.js",
    "testTargets": [
      "test/hello.test.js",
      "test/world.test.js"
    ],
    "testBuildConfigTargets": [
      "package.json"
    ],
    "evidenceFormat": "process-exit-plus-stdout"
  },
  "dependencyPolicy": "no_external_runtime_packages"
}
